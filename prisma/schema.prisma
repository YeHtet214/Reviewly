generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Agency {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // relations
  memberships Membership[]
  invitations Invitation[]
  projects    Project[]

  @@map("agency")
}

model User {
  id                    String                @id @default(cuid())
  name                  String
  email                 String
  emailVerified         Boolean
  image                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime
  sessions              Session[]
  accounts              Account[]
  memberships           Membership[]
  sentInvitations       Invitation[]
  createdProjects       Project[]
  clientProjectAccesses ClientProjectAccess[]

  @@unique([email])
  @@map("user")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationType {
  MEMBER
  CLIENT
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  OVERDUE
}

model Membership {
  id       String   @id @default(cuid())
  userId   String
  agencyId String
  role     Role
  joinedAt DateTime @default(now())

  // relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@map("membership")
}

model Invitation {
  id              String         @id @default(cuid())
  type            InvitationType
  email           String
  tokenHash       String         @unique
  agencyId        String?
  projectId       String?
  role            Role?
  invitedByUserId String?
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime       @default(now())

  // relations
  agency        Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedByUser User?    @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([agencyId])
  @@index([projectId])
  @@map("invitation")
}

model Project {
  id              String        @id @default(cuid())
  agencyId        String
  name            String
  description     String
  status          ProjectStatus
  createdAt       DateTime      @default(now())
  dueAt           DateTime?
  createdByUserId String

  // relations
  agency                Agency                @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdByUser         User                  @relation(fields: [createdByUserId], references: [id])
  clientProjectAccesses ClientProjectAccess[]
  approvalItems         ApprovalItem[]
  invitations           Invitation[]

  @@index([agencyId])
  @@map("project")
}

model ApprovalItem {
  id          String         @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      ApprovalStatus @default(DRAFT)
  dueAt       DateTime?
  createdAt   DateTime       @default(now())

  // relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([dueAt])
  @@map("approval_item")
}

model Client {
  id                    String                @id @default(cuid())
  email                 String                @unique
  name                  String?
  createdAt             DateTime              @default(now())
  clientProjectAccesses ClientProjectAccess[]
  sessions              ClientSession[]

  @@index([email])
  @@map("client")
}

model ClientProjectAccess {
  id        String @id @default(cuid())
  clientId  String
  projectId String

  invitedAt       DateTime  @default(now())
  invitedByUserId String?
  revokedAt       DateTime?

  createdAt DateTime @default(now())

  client        Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedByUser User?   @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([clientId, projectId])
  @@index([projectId])
  @@index([clientId])
  @@index([revokedAt])
  @@map("client_project_access")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model ClientSession {
  id        String    @id @default(cuid())
  clientId  String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("client_session")
}

model ClientLoginLink {
  id         String    @id @default(cuid())
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("client_login_link")
}
